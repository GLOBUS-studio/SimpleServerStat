# Normalize all text files to LF in the repository and working tree.
# This removes the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# Binary assets - never touch line endings.
*.png   binary
*.webp  binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
